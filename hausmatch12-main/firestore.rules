rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return getUserData().role == role;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (isOwner(resource.data.ownerId) || hasRole('manager'));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(resource.data.ownerId) || hasRole('manager'));
    }

    // Forum Threads
    match /forum_threads/{threadId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(resource.data.authorId) || hasRole('manager'));
    }

    // Forum Replies
    match /forum_replies/{replyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (isOwner(resource.data.authorId) || hasRole('manager'));
    }

    // Messages
    // IMPORTANT: list (query) and get (single read) are separate operations.
    // For onSnapshot queries (where senderId==uid or receiverId==uid) to work,
    // list must be allowed for any signed-in user. Individual document access
    // remains restricted to sender/receiver.
    match /messages/{messageId} {
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.senderId
      );
    }

    // Marktplatz (Schwarzes Brett)
    // Der vereinte Marktplatz liest aus dieser Collection. Beiträge sind öffentlich
    // lesbar (auch für Gäste); Kontaktdaten werden erst nach Login im Client gezeigt.
    // Erstellen/Löschen nur durch den eingeloggten Autor selbst.
    match /schwarzes_brett/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.authorId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
    }

    // Aufgaben (Legacy – formales Auftrags-Board, vom UI nicht mehr genutzt).
    // Regeln bleiben, damit vorhandene Daten zugänglich bleiben und nichts still bricht.
    match /aufgaben/{aufgabeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if isSignedIn();
    }

    // Bewerbungen (Legacy – Bewerbungen auf Aufgaben).
    match /bewerbungen/{bewerbungId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.managerId;
      allow update: if isSignedIn();
    }
  }
}
