# Firebase-Verbindung — Werte aus der Firebase Console:
# Projekt-Einstellungen → Allgemein → "Deine Apps" → Web-App → SDK-Konfiguration.
# Diese Datei ist nur eine Vorlage. Lokal NICHT hier eintragen, sondern in
# eine .env.local kopieren (wird von git ignoriert). In Produktion: Vercel →
# Project Settings → Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Vercel-Funktionen (Project Settings → Environment Variables) ────────────
# Resend (Mailversand) und Gemini werden dort gesetzt; zusätzlich seit 10/2026:
# Signiert die E-Mail-Adressen aus /api/search; ohne diesen Wert schreibt
# /api/send-inquiry Firmen aus der Live-Suche NICHT an (nur registrierte
# Verwalter). Mindestens 32 Zeichen, z. B. `openssl rand -hex 32`.
INQUIRY_SIGNING_SECRET=
# Optional: Vercel KV / Upstash Redis (REST), damit die Rate-Limits der
# Funktionen instanzübergreifend gelten. Ohne sie zählt jede Instanz für sich.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: Grenzen für /api/send-inquiry (Standard 5 je IP und Stunde, 300 je Tag).
INQUIRY_IP_LIMIT_PER_HOUR=
INQUIRY_DAILY_LIMIT=
