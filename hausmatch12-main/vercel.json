{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "redirects": [
      { "source": "/register", "destination": "/#/register", "permanent": false }
    ],
    "rewrites": [
          { "source": "/api/(.*)", "destination": "/api/$1" },
          { "source": "/(.*)", "destination": "/index.html" }
    ]
}
